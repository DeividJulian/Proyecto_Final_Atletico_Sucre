# Normalize line endings in the repo (the project is edited on Windows and deployed on Linux)
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.JPG  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.webm binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.apk  binary
*.aab  binary
