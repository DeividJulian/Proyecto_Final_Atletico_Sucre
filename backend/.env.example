# Copy this file to .env and fill in the values. .env is never committed.

# development (your machine: test accounts allowed) | production (Render: strict, no test accounts).
# If missing, the server assumes production.
ENVIRONMENT=development

# PostgreSQL in Supabase. For Render use the *Session pooler* URI (port 5432; the direct connection is IPv6-only).
# Paste it as Supabase shows it (postgresql://…); the app switches it to the psycopg driver:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Locally you can start with SQLite:
DATABASE_URL=sqlite:///./atletico_sucre.db

# Signs the JWT session tokens. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Hours a session lasts
TOKEN_HORAS=8

# The 2 administrators (coaches with is_admin = true), created on startup. Comma separated. Only here, never in code.
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Initial password of the admins (they are asked to change it). REQUIRED in production (min. 10 chars);
# in development, if empty, SEED_PASSWORD is used.
ADMIN_PASSWORD_INICIAL=

# Password of the test accounts created by `python seed.py` (profesor@…, padre@…, padre2@…).
# Only used with ENVIRONMENT=development; in production no test accounts are created.
SEED_PASSWORD=

# Only origins allowed by CORS (the Vercel domain in production). localhost:4200 is always allowed.
FRONTEND_ORIGIN=http://localhost:4200

# Password-recovery codes
CODIGO_MINUTOS=15
CODIGO_INTENTOS=5

# Email: consola (prints to the log) | memoria (tests) | brevo (HTTP API, production)
EMAIL_BACKEND=consola
BREVO_API_KEY=
EMAIL_FROM=no-reply@atleticosucre.local
EMAIL_FROM_NAME=Club Atlético Sucre

# Private files (player photos, payment receipts): local (folder below) | supabase (private bucket)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=atletico-sucre
MAX_UPLOAD_MB=5
